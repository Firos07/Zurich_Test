<Project Sdk="Microsoft.Build.Sql/2.2.0">

  <PropertyGroup>
    <Name>ClaimsDatabase</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <ModelCollation>1033,CI</ModelCollation>
    <TargetDatabase>ClaimsDb</TargetDatabase>
  </PropertyGroup>

  <ItemGroup>
    <!-- 01_create_database.sql crea la base de datos y no forma parte del modelo -->
    <Build Remove="scripts/01_create_database.sql" />
    <Build Include="scripts/02_create_tables.sql" />
    <Build Include="scripts/03_create_constraints.sql" />
    <Build Include="scripts/04_create_indexes.sql" />
    <PostDeploy Include="scripts/05_seed_data.sql" />
  </ItemGroup>

</Project>